<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ChipVision" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/chipvision_cyan</item>
        <item name="android:navigationBarColor">@color/chipvision_navy</item>
        <item name="android:statusBarColor">@color/chipvision_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ChipVision.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/chipvision_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ChipVision</item>
    </style>
</resources>
